# ~/.amux/telegram.env (chmod 600) — amux-telegram sidecar config for
# mac-server. MUST be a SEPARATE bot + group from any other machine's amux
# Telegram sidecar (and from the unrelated "agents" system's own bot on this
# same host) — see docs/telegram-chat.md "This is a separate bot" and the
# Per-host identity checklist in docs/mac-server-deploy.md.
#
# The sidecar refuses to start if this file is missing, group/other-readable,
# or missing a required key — see docs/telegram-chat.md §4.
#
# Copy this file to ~/.amux/telegram.env, fill in the three required values,
# then: chmod 600 ~/.amux/telegram.env

# Required — from @BotFather (docs/telegram-chat.md §1). A fresh bot, not the
# same token used on any other machine.
TG_BOT_TOKEN=

# Required — your numeric Telegram user id (docs/telegram-chat.md §2). Only
# this account may drive the sidecar.
TG_OWNER_ID=

# Required — the "Amux Server" forum supergroup's chat id, a negative number
# like -1001234567890 (docs/telegram-chat.md §3).
TG_CHAT_ID=

# Optional overrides — uncomment to change from the documented defaults.
# TG_API_BASE=https://api.telegram.org
# AMUX_BASE=https://localhost:8822
# TG_POLL_SECS=2.0
# TG_LONG_POLL_SECS=25
# TG_DEFAULT_MODE=smart
# TG_SUMMARY_MODEL=haiku
# TG_SUMMARY_TIMEOUT=90
# TG_SUMMARY_CONFIG_DIR=

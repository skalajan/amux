<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  amux dashboard/server LaunchAgent — rendered + installed by
  deploy/mac-server/install.sh (placeholders @@HOME@@ / @@CHECKOUT@@ / @@PYTHON@@
  substituted with real values; do not edit the rendered copy under
  ~/Library/LaunchAgents by hand — re-run install.sh instead).

  Invokes amux-server.py DIRECTLY from the checkout (never a copy elsewhere):
  this is the linchpin of the whole mac-server deploy — because @@CHECKOUT@@
  is the tracked git checkout amux-pull-update.sh pulls into, a `git pull`
  that changes amux-server.py IS a hot deploy. The server watches its own
  mtime and os.execv-restarts itself (~30s debounce) — this LaunchAgent's job
  is only to keep the *process* alive across crashes/reboots/logout, not to
  restart it on file change (the server does that itself).

  Requires Full Disk Access granted to @@PYTHON@@ in System Settings ->
  Privacy & Security -> Full Disk Access — a manual GUI (TCC) step under any
  execution mode; see docs/mac-server-deploy.md Phase 4.

  Manual install (what install.sh automates):
    cp com.amux.serve.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.amux.serve.plist
    launchctl enable  gui/$(id -u)/com.amux.serve
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amux.serve</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@PYTHON@@</string>
        <string>@@CHECKOUT@@/amux-server.py</string>
    </array>

    <!-- Run from the checkout so amux-server.py resolves relative paths. -->
    <key>WorkingDirectory</key>
    <string>@@CHECKOUT@@</string>

    <!-- launchd starts with a minimal PATH; put /usr/local/bin first for
         python3/git/tmux (whichever @@PYTHON@@ resolves through). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@@HOME@@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Keep the dashboard up across crashes, logout, and the server's own
         os.execv self-restarts (a self-restart is a normal exit+relaunch from
         launchd's point of view, not a crash — KeepAlive handles both). -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@@HOME@@/.amux/logs/serve.out.log</string>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/.amux/logs/serve.err.log</string>
</dict>
</plist>

# ~/.amux/defaults.env — global defaults applied to every `amux register`/
# `amux start` on this host (personal use, not the CI/agents system).
#
# This file is `source`d directly by the amux CLI (bash), so it must be valid
# bash — quote values, don't add stray characters. Copy this file to
# ~/.amux/defaults.env and edit; install.sh does this for you only if
# ~/.amux/defaults.env does not already exist (never clobbers a live config).

# Flags appended to every `claude` invocation unless a session overrides them
# with its own --model. Keep this in sync with server.env's AMUX_DEFAULT_MODEL
# if you want the dashboard's default-model label to agree.
CC_DEFAULT_FLAGS="--model sonnet"
